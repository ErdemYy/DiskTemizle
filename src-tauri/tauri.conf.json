{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskTemizle",
  "version": "0.1.0",
  "identifier": "com.disktemizle.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskTemizle",
        "width": 1100,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "publisher": "DiskTemizle",
    "shortDescription": "Güvenli disk temizleyici",
    "longDescription": "Önemli dosyalarınıza dokunmadan geçici dosyaları, önbellekleri, proje artıklarını, büyük ve yinelenen dosyaları güvenle temizler. Varsayılan olarak her şey Geri Dönüşüm Kutusu'na taşınır.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
